{
  "name": "@flow-dev/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./schemas/*": "./src/schemas/*.ts"
  },
  "scripts": {
    "dev": "env -u LD_PRELOAD sh -c 'tsx watch --env-file=../../apps/web/.env.local src/cli/tasksWorker.ts & tsx watch --env-file=../../apps/web/.env.local src/cli/issueDeletionWorker.ts & tsx --env-file=../../apps/web/.env.local src/cli/terminalSessionsWorker.ts & trap \"kill 0\" EXIT INT TERM; wait'",
    "sessions:worker": "tsx --env-file=../../apps/web/.env.local src/cli/terminalSessionsWorker.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../apps/web/.env.local src/cli/databaseMigrate.ts",
    "catalog:import": "tsx src/cli/catalogImport.ts",
    "admins:provision": "tsx src/cli/adminsProvision.ts",
    "board:backfill": "tsx src/cli/boardBackfill.ts",
    "labels:backfill": "tsx src/cli/labelsBackfill.ts",
    "test": "vitest run",
    "codex:protocol": "tsx scripts/syncCodexProtocol.ts",
    "tasks:worker": "tsx src/cli/tasksWorker.ts",
    "db:prepare": "tsx src/cli/databasePrepare.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "claims:reconcile": "tsx --env-file=../../apps/web/.env.local src/cli/claimsReconciler.ts",
    "issue-deletion:worker": "tsx --env-file=../../apps/web/.env.local src/cli/issueDeletionWorker.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
