{
  "name": "@flow-dev/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./schemas/*": "./src/schemas/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "catalog:import": "tsx src/cli/catalogImport.ts",
    "admins:provision": "tsx src/cli/adminsProvision.ts"
    ,"test": "vitest run"
  },
  "dependencies": {
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
    ,"tsx": "^4.20.6"
  }
}
